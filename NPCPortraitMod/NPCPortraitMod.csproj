<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NPCPortraitMod</AssemblyName>
    <RootNamespace>NPCPortraitMod</RootNamespace>
    <!-- Default GamePath if not specified in environment or build args -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\鬼谷八荒</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ตำแหน่งอ้างอิงไฟล์ DLL ของเกมและ MelonLoader -->
    <!-- ให้คุณนำไฟล์ DLL เหล่านี้มาใส่ในโฟลเดอร์ libs ที่อยู่ในโฟลเดอร์เดียวกับโปรเจกต์นี้ -->
    <Reference Include="MelonLoader">
      <HintPath>libs\MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="UnhollowerBaseLib">
      <HintPath>libs\UnhollowerBaseLib.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>libs\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>libs\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>libs\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>libs\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>libs\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>libs\Unity.TextMeshPro.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Auto-copy to Mods folder only if the target directory exists on the building machine -->
  <Target Name="CopyModToGame" AfterTargets="Build">
  <Copy
    SourceFiles="$(TargetPath)"
    DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\鬼谷八荒\Mods"
    SkipUnchangedFiles="true" />
  </Target>

</Project>
